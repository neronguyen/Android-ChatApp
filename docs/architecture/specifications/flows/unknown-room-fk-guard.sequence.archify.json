    {
      "dot": "emerald",
      "title": "Foreign Key Guard & Non-Blocking Ingestion",
      "items": [
        "Indexed Existence Check: SELECT EXISTS(SELECT 1 FROM chat_rooms WHERE id = :roomId) executes in <0.1ms",
        "Non-Blocking Collector: REST metadata fetch runs in background appScope without pausing WebSocket event stream",
        "Single-Flight Deduplication: Multiple incoming frames for the same uncached room trigger only one REST fetch"
      ]
    },
    {
      "dot": "rose",
      "title": "Resilience & Memory Safety",
      "items": [
        "Bounded Buffer: Per-room message queue capped at MAX_PENDING_MESSAGES_PER_ROOM = 50",
        "Safe Discard on Failure: Failed room fetch safely discards buffered frames without throwing SQLiteConstraintException",
        "Defensive Guard: Room DAO write calls wrapped in try-catch to defend against concurrent room deletion"
