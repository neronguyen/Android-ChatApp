  "cards": [
    {
      "dot": "emerald",
      "title": "Decoupled Edge Scheduling & Instant Recovery",
      "items": [
        "Modular WorkManager: ChatSyncWorker resides in :sync:work and delegates to ChatSyncManager without coupling to :core:datastore",
        "Proactive Reachability: NetworkMonitor cancels reconnect backoff with 0ms delay upon network recovery, avoiding 32s ping timeouts",
        "Anti-Flapping Backoff: retryAttempt counter resets strictly upon WebSocket CONNECTED, preserving exponential backoff on flaky networks"
      ]
    },
    {
      "dot": "amber",
      "title": "Consistency & Parallel Prefetch Invariants",
      "items": [
        "Bounded Parallel Prefetch: Semaphore(3) limits concurrent message requests across dirty rooms, eliminating sequential waterfall latency",
        "Fail-Fast Error Propagation: If any room prefetch fails (errors.isNotEmpty()), catch-up returns Either.Left to prompt WorkManager retry",
        "Single-Flight Mutex: inFlightSync?.takeIf { it.isActive } prevents duplicate concurrent GET /api/chat/rooms network requests"
      ]
    }
  ]
