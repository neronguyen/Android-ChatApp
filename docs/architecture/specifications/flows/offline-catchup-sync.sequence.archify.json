  "cards": [
    {
      "dot": "emerald",
      "title": "Offline-First Self-Healing & Coalescing",
      "items": [
        "Periodic + Catch-Up Work: 15-min battery-friendly PeriodicWorkRequest plus network-constrained OneTimeWorkRequest on sync failure",
        "WebSocket Reconnect Reconcile: Immediate catch-up triggered upon socket reconnection to recover dropped realtime frames",
        "Single-Flight Deduplication: Simultaneous UI, WorkManager, and WS reconnect triggers share a single in-flight GET /api/chat/rooms call"
      ]
    },
    {
      "dot": "amber",
      "title": "Consistency & Local State Invariants",
      "items": [
        "Conditional Prefetch (Cap 5): Automatically prefetches recent messages for up to 5 most recently active changed rooms",
        "Authoritative Stale Pruning: Local rooms missing from GET /api/chat/rooms are deleted via ForeignKey.CASCADE",
        "Optimistic Preview Preservation: Local SENDING or FAILED messages newer than server lastMessage remain as the room preview"
      ]
    }
  ]
