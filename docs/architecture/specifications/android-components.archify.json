  "cards": [
    {
      "dot": "cyan",
      "title": "Offline-First SSOT & Optimistic UI",
      "items": [
        "Room (ChatDao) is the Single Source of Truth; ViewModels observe reactive SQLite Flows while syncing in the background",
        "Outgoing messages insert immediately as SENDING in Room before dispatching WsClientMessage over WebSocket"
      ]
    },
    {
      "dot": "emerald",
      "title": "Lifecycle-Aware Realtime & Single-Flight Auth",
      "items": [
        "RealtimeConnectionManager combines ProcessLifecycleOwner and AuthState to supervise WebSocket connections with exponential backoff",
        "AuthRepositoryImpl implements TokenRefresher with a Mutex lock so concurrent HTTP 401s trigger only one refresh request"
      ]
    },
    {
      "dot": "amber",
      "title": "Hardware-Backed Token Security",
      "items": [
        "PreferencesTokenDataSource encrypts access and refresh tokens via AndroidKeyStore AES-256 GCM before persisting to DataStore",
        "AuthInterceptor and TokenAuthenticator share the authenticated OkHttp pipeline across both REST and WebSocket (/ws/chat) upgrades"
      ]
    }
  ]
}
